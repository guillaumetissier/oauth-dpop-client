{
  "name": "@guillaumetissier/oauth-dpop-client",
  "version": "0.1.0",
  "description": "Browser OAuth2 client for Authorization Code + PKCE with DPoP-bound tokens (RFC 9449), WebCrypto only, zero dependencies.",
  "keywords": [
    "oauth2",
    "pkce",
    "dpop",
    "rfc9449",
    "webcrypto",
    "spa",
    "javascript",
    "browser"
  ],
  "license": "MIT",
  "author": "Guillaume Tissier",
  "homepage": "https://github.com/guillaumetissier/oauth-dpop-client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guillaumetissier/oauth-dpop-client.git"
  },
  "bugs": "https://github.com/guillaumetissier/oauth-dpop-client/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/oauth-dpop.js",
  "types": "./dist/oauth-dpop.d.ts",
  "exports": {
    ".": {
      "types": "./dist/oauth-dpop.d.ts",
      "default": "./dist/oauth-dpop.js"
    },
    "./global": "./dist/oauth-dpop.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-global.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "unpkg": "./dist/oauth-dpop.global.js",
  "jsdelivr": "./dist/oauth-dpop.global.js"
}
